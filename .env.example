# Copy to .env (never commit .env). Secrets live in the environment, not in the code.
# Nothing here is required for research/backtesting.

# --- Paper / broker credentials (Stage 2+; not used by the current prototype) ---
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497          # 7497 = TWS paper, 7496 = TWS live, 4002 = IB Gateway paper
# IBKR_CLIENT_ID=1

# --- Discord: incoming webhook (Channel settings > Integrations > Webhooks). It is a secret.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# --- News agent (optional, paid APIs) ---
# X_BEARER_TOKEN=                 # X API v2 app-only bearer token
# ANTHROPIC_API_KEY=              # for the advisory briefing

# --- Live trading: DISABLED by default. Both conditions below are required AND
# --- live_trading.enabled must be true in the config. Leave unset until Stage 4.
# QUANTLAB_LIVE_CONFIRM=YES_I_AUTHORIZE_REAL_ORDERS
